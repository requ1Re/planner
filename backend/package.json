    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express-session": "^1.19.0",
    "passport-jwt": "^4.0.1",
    "passport-oauth2": "^1.8.0",
    "passport-openidconnect": "^0.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
